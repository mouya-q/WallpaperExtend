#version 450

// Gaussian Blur Compute Shader
// Vertical pass

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer InputBuffer {
    vec4 inputData[];
} input_buffer;

layout(std430, binding = 1) buffer OutputBuffer {
    vec4 outputData[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    float sigma;
    int radius;
} push;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);

    if (x >= push.width || y >= push.height) return;

    float sigma = push.sigma;
    int radius = push.radius;

    float sumR = 0.0, sumG = 0.0, sumB = 0.0, sumA = 0.0;
    float totalWeight = 0.0;

    for (int i = -radius; i <= radius; i++) {
        int yi = ((y + i) % push.height + push.height) % push.height;
        int idx = yi * push.width + x;

        vec4 pixel = input_buffer.inputData[idx];
        float weight = exp(-float(i * i) / (2.0 * sigma * sigma));

        sumR += pixel.r * weight;
        sumG += pixel.g * weight;
        sumB += pixel.b * weight;
        sumA += pixel.a * weight;
        totalWeight += weight;
    }

    output_buffer.outputData[y * push.width + x] = vec4(
        sumR / totalWeight,
        sumG / totalWeight,
        sumB / totalWeight,
        sumA / totalWeight
    );
}