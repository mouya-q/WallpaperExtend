#version 450

// Blend Compute Shader
// Alpha blending with gradient mask

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer InputBuffer {
    vec4 inputData[];
} input_buffer;

layout(std430, binding = 1) buffer OutputBuffer {
    vec4 outputData[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    int featherStart;
    int featherEnd;
} push;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);

    if (x >= push.width || y >= push.height) return;

    vec4 src = input_buffer.inputData[y * push.width + x];
    vec4 dst = output_buffer.outputData[y * push.width + x];

    float alpha = 1.0;

    if (y >= push.featherStart && y < push.featherEnd) {
        alpha = float(y - push.featherStart) / float(push.featherEnd - push.featherStart);
    } else if (y < push.featherStart) {
        alpha = 0.0;
    }

    output_buffer.outputData[y * push.width + x] = mix(src, dst, alpha);
}